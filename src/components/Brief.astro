---
import site from '../data/site.json'
---
<div class="nl-bd" id="nl-bd" hidden></div>
<div class="nl" id="nl" role="dialog" aria-modal="true" aria-labelledby="nl-h" hidden>
  <button class="nl-x" type="button" aria-label="Close" data-nl-close>×</button>
  <div class="nl-top">
    <span class="nm-mk" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="nl-k">Before you go · The Redbarn Brief</span>
  </div>
  <h2 id="nl-h">One page. Once a month. <b>Zero fluff.</b></h2>
  <p class="nl-p">The ideas we share with CEOs over coffee - on brand, websites and growth - in a two-minute monthly read.</p>
  <ul class="nl-items" aria-label="In every issue"><li><span>01</span>One move worth making</li><li><span>02</span>One fix worth stealing</li><li><span>03</span>One idea from the market</li></ul>
  <form id="nl-form" novalidate>
    <label class="sr" for="nl-email">Work email</label>
    <div class="nl-row"><input id="nl-email" name="email" type="email" autocomplete="email" placeholder="Your work email" required /><button class="btn btn-p" type="submit"><span class="lbl">Get the Brief</span></button></div>
    <div class="nl-roles" role="group" aria-label="Your role (optional)">
      {['CEO or founder', 'Marketing', 'Sales', 'Other'].map((r) => <label class="nl-r"><input type="radio" name="role" value={r} /><span>{r}</span></label>)}
    </div>
    <input type="text" name="_honey" class="nl-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <p class="nl-fine">No spam, unsubscribe any time. <a href="/privacy">Privacy policy</a></p>
    <p class="nl-err" role="alert" hidden></p>
  </form>
  <div class="nl-done" role="status" hidden><b>You are on the list.</b><p>Your first Brief arrives at the start of next month.</p></div>
</div>
<script define:vars={{ to: site.formTo }}>
(function(){
  var el=document.getElementById('nl'); if(!el) return;
  var K='rb_nl', now=Date.now();
  try{var v=JSON.parse(localStorage.getItem(K)||'null'); if(v&&(v.s==='joined'||now-v.t<14*864e5)) return}catch(e){}
  if(/^\/contact/.test(location.pathname)) return;
  var shown=false, t0=Date.now(), bd=document.getElementById('nl-bd'), last=null;
  function show(){ if(shown||document.body.classList.contains('nav-open')) return; shown=true; last=document.activeElement; el.hidden=false; bd.hidden=false; requestAnimationFrame(function(){el.classList.add('on'); bd.classList.add('on'); setTimeout(function(){ var i=document.getElementById('nl-email'); i&&i.focus({preventScroll:true}) },400)}); }
  function save(s){ try{localStorage.setItem(K,JSON.stringify({s:s,t:Date.now()}))}catch(e){} }
  function close(){ el.classList.remove('on'); bd.classList.remove('on'); save('closed'); setTimeout(function(){el.hidden=true;bd.hidden=true},450); last&&last.focus&&last.focus({preventScroll:true}) }
  bd.addEventListener('click', close);
  // desktop: leaving intent (pointer heads to the tab bar or close button)
  document.documentElement.addEventListener('mouseleave', function(e){ if(e.clientY<=0 && Date.now()-t0>8000) show() });
  // touch devices: a quick scroll back up after reading most of the page
  if(matchMedia('(pointer: coarse)').matches){ var ly=scrollY, deep=false; var m=0; function mm(){ m=document.documentElement.scrollHeight-innerHeight } addEventListener('load', mm); addEventListener('resize', mm); mm(); addEventListener('scroll', function(){ if(m>0&&scrollY/m>0.5) deep=true; if(deep && ly-scrollY>140 && Date.now()-t0>15000) show(); ly=scrollY }, {passive:true}) }
  el.querySelector('[data-nl-close]').addEventListener('click', close);
  addEventListener('keydown', function(e){ if(e.key==='Escape'&&el.classList.contains('on')) close() });
  var f=document.getElementById('nl-form'), err=el.querySelector('.nl-err'), btn=f.querySelector('button'), lbl=btn.querySelector('.lbl');
  f.addEventListener('submit', function(e){
    e.preventDefault(); err.hidden=true;
    var em=f.email.value.trim(); if(!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(em)){ err.textContent='Please enter a valid email address.'; err.hidden=false; f.email.focus(); return }
    var role=(f.querySelector('input[name=role]:checked')||{}).value||'-';
    function done(){ f.hidden=true; el.querySelector('.nl-done').hidden=false; save('joined'); setTimeout(function(){ el.classList.remove('on'); bd.classList.remove('on'); setTimeout(function(){el.hidden=true;bd.hidden=true},450) }, 3200) }
    if(f._honey.value){ done(); return }
    btn.disabled=true; lbl.textContent='Joining...';
    fetch('/api/brief',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:em,role:role,source:location.pathname})})
      .then(function(r){ return r.json().catch(function(){return {}}).then(function(j){ if(!r.ok||!j.ok) throw 0; done() }) })
      .catch(function(){ err.textContent='Could not save that just now - please try again in a moment.'; err.hidden=false })
      .finally(function(){ btn.disabled=false; lbl.textContent='Get the Brief' });
  });
})();
</script>
