---
import site from '../data/site.json'
import Arrow from './Arrow.astro'
interface Props { title?: string; lead?: string }
const { title = 'Tell us about your brand.', lead = 'A few lines about your business and what you need is enough. We will arrange a short call and come back with a written plan and quote.' } = Astro.props
---
<section class="frame row cta" aria-label="Contact">
  <div class="hatch side" aria-hidden="true"></div>
  <div class="cta-c">
    <span class="chip"><i></i>Taking on new projects</span>
    <h2 class="display" data-split data-bold="2">{title}</h2>
    <p class="lead rv">{lead}</p>
    <div class="hero-btns rv">
      <a href="/contact" class="btn btn-p">Start a project <Arrow /></a>
      <a href={`mailto:${site.email}?subject=${encodeURIComponent('Project enquiry')}`} class="btn btn-o">Email us</a>
    </div>
  </div>
  <div class="hatch side" aria-hidden="true"></div>
</section>
