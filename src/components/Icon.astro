---
interface Props { kind: string; class?: string }
const { kind, class: cls = '' } = Astro.props
---
<svg class={`ico ${cls}`} viewBox="0 0 24 24" aria-hidden="true">
  {kind === 'cube' && <><rect x="3.5" y="3.5" width="17" height="17" /><circle class="r" cx="12" cy="12" r="4.5" /></>}
  {kind === 'slabs' && <><rect x="3" y="15.5" width="15" height="4" /><rect x="6" y="10.5" width="15" height="4" /><path d="M4.5 9.5V5.5h9v2h3v2" /><path class="r" d="M13.5 5.5v2" /></>}
  {kind === 'arrow' && <><path d="M3 9h10V4.5L21 12l-8 7.5V15H3z" /><path class="r" d="M4.5 12h8.5" /></>}
  {kind === 'monolith' && <><rect x="7" y="2.5" width="10" height="19" /><rect class="r" x="11" y="6" width="2" height="10" /></>}
  {kind === 'sphere' && <><path d="M12 3a9 9 0 1 0 9 9h-9z" /><path class="r" d="M12 3v9h9" /><path d="M4 8.5h8M3.2 14h17.6M5 17.5h14" /></>}
  {kind === 'lattice' && <><path d="M5 5h14v14H5zM12 5v14M5 12h14" /><circle cx="5" cy="5" r="1.2" /><circle cx="12" cy="5" r="1.2" /><circle class="r" cx="19" cy="5" r="1.4" /><circle cx="5" cy="12" r="1.2" /><circle cx="12" cy="12" r="1.2" /><circle cx="19" cy="12" r="1.2" /><circle cx="5" cy="19" r="1.2" /><circle cx="12" cy="19" r="1.2" /><circle cx="19" cy="19" r="1.2" /></>}
  {kind === 'chip' && <><rect x="6" y="6" width="12" height="12" /><rect class="r" x="9.5" y="9.5" width="5" height="5" /><path d="M9 3v3M12 3v3M15 3v3M9 18v3M12 18v3M15 18v3M3 9h3M3 12h3M3 15h3M18 9h3M18 12h3M18 15h3" /></>}
  {kind === 'funnel' && <><rect x="3" y="16" width="18" height="4" /><rect x="6" y="10.5" width="12" height="4" /><rect class="r" x="9" y="5" width="6" height="4" /></>}
  {kind === 'phone' && <><rect x="7" y="2.5" width="10" height="19" rx="1.5" /><rect class="r" x="9" y="5" width="6" height="11" /><path d="M11 19h2" /></>}
  {kind === 'screen' && <><rect x="3" y="4" width="18" height="12" /><path class="r" d="M10.5 7.5v5l4-2.5z" /><path d="M12 16v3M8 20.5h8" /></>}
  {kind === 'booth' && <><path d="M3 20.5h18M4 20.5V5h16v15.5" /><rect class="r" x="6.5" y="7" width="11" height="6" /><rect x="9" y="15" width="7" height="5.5" /></>}
</svg>
