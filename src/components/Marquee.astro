---
import fs from 'node:fs'
import path from 'node:path'
import site from '../data/site.json'
interface Props { title?: string; lead?: string }
const { title = 'The tools behind the work.', lead = 'Proven technology for each job, fluent in the platforms you already use.' } = Astro.props
const slug = (t: string) => t.toLowerCase().replace(/\./g, 'dot').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
const logo = (t: string) => {
  for (const ext of ['svg', 'png', 'webp']) {
    const f = `logos/${slug(t)}.${ext}`
    if (fs.existsSync(path.join(process.cwd(), 'public', f))) return '/' + f
  }
  return null
}
const rows = [
  { k: 'Technologies', items: site.tech, dir: 'l' },
  { k: 'Platforms', items: site.platforms, dir: 'r' },
]
---
<section class="frame row mq-sec" aria-labelledby="mq-h">
  <div class="sec-h in-pad">
    <div><span class="label faint">/Stack</span><h2 class="h2" id="mq-h" data-split data-bold="2">{title}</h2></div>
    <p class="lead rv">{lead}</p>
  </div>
  {rows.map((r) => (
    <div class="mq-row">
      <span class="mq-k"><span class="label">{r.k}</span><span class="mq-c">{r.items.length}</span></span>
      <p class="mq-sr">{`${r.k}: ${r.items.join(', ')}`}</p>
      <div class={`mq ${r.dir}`} aria-hidden="true">
        <ul class="mq-t">
          {[...r.items, ...r.items].map((t, i) => { const src = logo(t); return (
            <li aria-hidden="true" class={src ? 'has-img' : ''}>{src ? <img src={src} alt="" loading="lazy" decoding="async" /> : <span class="mq-w">{t}</span>}</li>
          ) })}
        </ul>
      </div>
    </div>
  ))}
</section>
<style>
  .mq-row{display:grid;grid-template-columns:200px 1fr;border-top:1px solid var(--line);align-items:stretch}
  .mq-k{padding:0 var(--pad);border-right:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:10px;color:var(--faint)}
  .mq-c{font-size:11px;border:1px solid var(--line);border-radius:5px;padding:1px 6px}
  .mq{overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent);mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent)}
  .mq-t{display:flex;width:max-content;animation:mq 60s linear infinite}
  .mq.r .mq-t{animation-direction:reverse;animation-duration:66s}
  .mq:hover .mq-t{animation-play-state:paused}
  .mq li{display:flex;align-items:center;justify-content:center;height:96px;padding:0 clamp(28px,3.2vw,52px);border-right:1px solid var(--line);white-space:nowrap}
  .mq-w{font-size:clamp(20px,1.9vw,27px);font-weight:600;letter-spacing:-.035em;color:var(--faint);transition:color .3s}
  .mq-sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
  .mq li:hover .mq-w{color:var(--ink)}
  .mq img{height:30px;width:auto;max-width:140px;filter:grayscale(1) contrast(.8) opacity(.55);transition:filter .35s}
  .mq li:hover img{filter:none}
  @keyframes mq{to{transform:translateX(-50%)}}
  @media (max-width:768px){.mq-row{grid-template-columns:1fr}.mq-k{border-right:0;border-bottom:1px solid var(--line);padding:12px var(--pad)}.mq li{height:72px}}
  @media (prefers-reduced-motion:reduce){.mq-t{animation:none;flex-wrap:wrap;width:auto}.mq-t li:nth-child(n+16){display:none}.mq{-webkit-mask-image:none;mask-image:none}}
</style>
