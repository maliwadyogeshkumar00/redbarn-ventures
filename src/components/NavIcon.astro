---
// Crisp 24px line icons for the Services menu. Ink strokes + one red accent (.a).
interface Props { kind: string }
const { kind } = Astro.props
---
<svg class="ni" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {kind === 'cube' && <><path d="M12 3 4.5 13.5 12 21l7.5-7.5L12 3Z"/><path d="M12 3v7.5"/><circle class="a" cx="12" cy="12.6" r="2.1"/></>}
  {kind === 'lattice' && <><rect x="3" y="4.5" width="18" height="15" rx="2.5"/><path d="M3 9h18"/><circle class="a" cx="6.2" cy="6.8" r=".9"/><path d="M7.5 13h5M7.5 16h9"/></>}
  {kind === 'chip' && <><rect x="6" y="6" width="12" height="12" rx="2.5"/><path d="M9.5 3v3M14.5 3v3M9.5 18v3M14.5 18v3M3 9.5h3M3 14.5h3M18 9.5h3M18 14.5h3"/><rect class="a" x="9.5" y="9.5" width="5" height="5" rx="1"/></>}
  {kind === 'slabs' && <><path d="M4 10v4a1 1 0 0 0 1 1h2l6 4.5V4.5L7 9H5a1 1 0 0 0-1 1Z"/><path class="as" d="M16.5 9a4 4 0 0 1 0 6M19 6.5a7.5 7.5 0 0 1 0 11"/></>}
  {kind === 'sphere' && <><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/><path class="a" d="M10.5 7.2l.9 2.4 2.4.9-2.4.9-.9 2.4-.9-2.4-2.4-.9 2.4-.9Z"/></>}
  {kind === 'funnel' && <><path d="M3.5 4.5h17l-6.5 8v6l-4 2v-8Z"/><circle class="a" cx="12" cy="8" r="1.6"/></>}
  {kind === 'phone' && <><circle cx="9.5" cy="8" r="3.5"/><path d="M3 20c.6-3.6 3.2-5.5 6.5-5.5S15.4 16.4 16 20"/><path class="a" d="M18.5 5.5l.8 1.7 1.7.8-1.7.8-.8 1.7-.8-1.7-1.7-.8 1.7-.8Z"/></>}
  {kind === 'screen' && <><rect x="3" y="5" width="18" height="14" rx="2.5"/><path class="a" d="M10 9.2v5.6l4.8-2.8Z"/></>}
  {kind === 'booth' && <><path d="M6 21V3.5"/><path class="a" d="M6 4h12l-2.5 3.5L18 11H6Z"/><path d="M3.5 21h6"/></>}
  {kind === 'arrow' && <><circle cx="12" cy="12" r="8.5"/><path class="a" d="M15.5 8.5 13.3 13.3 8.5 15.5l2.2-4.8Z"/></>}
  {kind === 'monolith' && <><path d="M7 3.5h7.5L19 8v11a1.5 1.5 0 0 1-1.5 1.5h-10A1.5 1.5 0 0 1 6 19V5a1.5 1.5 0 0 1 1-1.5Z"/><path d="M14.5 3.5V8H19"/><path class="as" d="M9.5 13v4M12.5 11v6M15.5 14.5v2.5"/></>}
</svg>
