---
import site from '../data/site.json'
import Logo from './Logo.astro'
import Art from './Art.astro'
const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const cur = (h: string) => (h === '/' ? path === '/' : path === h || path.startsWith(h + '/'))
---
<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Site menu" aria-hidden="true">
  <div class="wrap menu-top">
    <Logo />
    <button class="menu-btn" type="button" data-menu-close>Close <i></i></button>
  </div>
  <div class="wrap menu-body">
    <nav class="menu-list" aria-label="Main">
      <ul>
        {site.nav.map((l) => (
          <li><a href={l.href} data-obj={l.obj} aria-current={cur(l.href) ? 'page' : undefined}><small>{l.n}</small><span class="d"></span>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="menu-art" aria-hidden="true">
      {[...new Set(site.nav.map((l) => l.obj))].map((k) => <div class="ma" data-k={k}><Art kind={k} /></div>)}
    </div>
  </div>
  <div class="wrap">
    <div class="menu-foot">
      <a class="big" href={`mailto:${site.email}`}>{site.email}</a>
      <span class="label mute">Design · Marketing · Consultancy · Corporate · Investing</span>
    </div>
  </div>
</div>
