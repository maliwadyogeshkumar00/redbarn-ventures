      <span class="label clock mute" data-clock aria-label="Your local time">--:--</span>
      <button class="menu-btn" type="button" data-menu-open aria-controls="menu" aria-expanded="false">Menu <i></i></button>
    </div>
  </div>
</header>
<button class="menu-btn float" type="button" data-menu-open aria-controls="menu" aria-expanded="false">Menu <i></i></button>
