---
interface Props { variant?: 'primary' | 'white' | 'black' | 'reversed'; size?: number; mark?: boolean }
const { variant = 'primary', size = 48, mark = false } = Astro.props
const src = mark ? '/logo-mark.svg' : variant === 'black' ? '/logo-mono.svg' : variant === 'white' || variant === 'reversed' ? '/logo-white.svg' : '/logo.svg'
const h = Math.round(size * 0.62)
---
<img class="lg" src={src} alt="Redbarn Ventures" height={h} style={`height:${h}px;width:auto;display:block`} />
