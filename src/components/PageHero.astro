---
interface Props { label: string; title: string; lead?: string; crumbs?: { t: string; h?: string }[] }
const { label, title, lead, crumbs = [] } = Astro.props
---
<section class="frame hero">
  <div class="hero-grid">
    <div class="hatch side" aria-hidden="true"></div>
    <div class="hero-c ph">
      {crumbs.length > 0 && (
        <nav class="crumbs rv" aria-label="Breadcrumb"><a href="/">Home</a>{crumbs.map((c) => <><span aria-hidden="true">/</span>{c.h ? <a href={c.h}>{c.t}</a> : <span aria-current="page">{c.t}</span>}</>)}</nav>
      )}
      <span class="chip rv"><i></i>{label}</span>
      <h1 class="display" data-split data-bold="3" data-delay="100">{title}</h1>
      {lead && <p class="lead rv" style="transition-delay:.25s">{lead}</p>}
      <slot />
    </div>
    <div class="hatch side" aria-hidden="true"></div>
  </div>
  <div class="strip" aria-hidden="true"><span></span><span class="hatch"></span><span></span><span class="hatch"></span><span></span><span class="hatch"></span><span></span></div>
</section>
