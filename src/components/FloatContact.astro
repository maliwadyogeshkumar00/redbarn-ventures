---
import site from '../data/site.json'
const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hi Redbarn, I would like to discuss a project.')}`
---
<aside class="nudge" aria-label="Contact options" data-nudge>
  <button class="nudge-tab" type="button" aria-expanded="false" aria-controls="nudge-body" data-nudge-toggle><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="2" y="3.5" width="12" height="9" rx="1.5"/><path d="M2.5 4.5 8 9l5.5-4.5"/></svg>Email us</button>
  <div class="nudge-body" id="nudge-body">
    <div class="nb-top"><b>Talk to a senior person</b><button type="button" class="nb-x" aria-label="Close" data-nudge-close>×</button></div>
    <p>Have a brief, a deadline or just a question? Send a message and we reply personally.</p>
    <a class="em" href={`mailto:${site.email}?subject=${encodeURIComponent('Project enquiry')}`}>{site.email}</a>
    <a class="btn btn-p btn-sm" href="/contact" style="justify-content:center">Open the contact form</a>
    <a class="btn btn-o btn-sm" href={wa} target="_blank" rel="noopener" style="justify-content:center">WhatsApp us</a>
  </div>
</aside>
<a class="wa" href={wa} target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
  <span class="wa-tip">Chat on WhatsApp</span>
  <svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16 3C8.8 3 3 8.7 3 15.8c0 2.5.7 4.9 2 7L3 29l6.4-2c2 1.1 4.3 1.7 6.6 1.7 7.2 0 13-5.7 13-12.8S23.2 3 16 3zm0 23.4c-2.1 0-4.1-.6-5.9-1.6l-.4-.3-3.8 1.2 1.2-3.7-.3-.4c-1.2-1.8-1.8-3.9-1.8-6 0-5.9 4.9-10.7 11-10.7s11 4.8 11 10.7S22.1 26.4 16 26.4zm6-8c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.8-1.6-1.9-1.8-2.2-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.3.3-.6.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.7s1.2 3.2 1.4 3.4c.2.2 2.4 3.6 5.8 5 .8.3 1.4.5 1.9.7.8.2 1.5.2 2.1.1.6-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.3-.6-.4z"/></svg>
</a>
