---
interface Props { items: { q: string; a: string }[]; title?: string; lead?: string; id?: string }
const { items, title = 'Questions we hear before every project.', lead = 'Something else on your mind? Send us an email or use the contact form - a senior person replies, not a bot.', id = 'faq' } = Astro.props
---
<section class="frame row faq" id={id} aria-labelledby={`${id}-h`}>
  <div class="faq-grid">
    <div class="faq-l in-pad">
      <span class="label faint">/FAQ</span>
      <h2 class="h2" id={`${id}-h`} data-split data-bold="2">{title}</h2>
      <p class="lead rv">{lead}</p>
    </div>
    <div class="faq-r">
      {items.map((f, i) => (
        <details class="qa" open={i === 0}>
          <summary><span>{f.q}</span><i aria-hidden="true"></i></summary>
          <p class="mute">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<script>
  const qas = [...document.querySelectorAll<HTMLDetailsElement>('.qa')]
  qas.forEach((d) => d.addEventListener('toggle', () => { if (d.open) qas.forEach((o) => { if (o !== d) o.open = false }) }))
</script>
