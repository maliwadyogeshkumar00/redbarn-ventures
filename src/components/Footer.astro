---
import site from '../data/site.json'
import Arrow from './Arrow.astro'
import Logo from './Logo.astro'
---
<footer class="foot">
  <div class="wrap">
    <div class="talk hl">
      <a class="big" href="/contact">Let's talk<Arrow dir="ne" /></a>
    </div>
    <div class="g foot-grid">
      <div style="grid-column:span 4"><span class="label mute">Email</span><a href={`mailto:${site.email}`} class="lead">{site.email}</a></div>
      <div style="grid-column:span 2" class="vl-pad"><span class="label mute">Studio</span><a href="/work">Work</a><a href="/services">Services</a><a href="/about">About</a></div>
      <div style="grid-column:span 2"><span class="label mute">Capital</span><a href="/investing">Investing</a><a href="/contact">Contact</a></div>
      <div style="grid-column:span 2"><span class="label mute">Legal</span><a href="/imprint">Imprint</a><a href="/privacy">Privacy</a></div>
    </div>
    <div class="foot-bot">
      <Logo />
      <span class="label mute">©2026 Redbarn Ventures</span>
      <a href="#top" class="totop" data-top data-no-wipe aria-label="Back to top"><Arrow dir="up" /></a>
    </div>
  </div>
</footer>
<style>
  @media (max-width:768px){ .foot-grid>div{grid-column:span 6!important;margin-bottom:24px} .foot-grid>div:first-child{grid-column:span 12!important} .foot-bot{flex-wrap:wrap} }
</style>
