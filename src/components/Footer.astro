---
import site from '../data/site.json'
import services from '../data/services.json'
import Logo from './Logo.astro'
import LinkedIn from './LinkedIn.astro'
---
<footer class="frame" style="border-top:1px solid var(--line)">
  <div class="foot-cols">
    <div>
      <Logo />
      <p class="mute" style="margin-top:10px;max-width:34ch">A global brand, digital and growth agency. Established 2023. One senior team for your brand, website, AI and growth - before, during and long after launch.</p>
      <span class="label faint" style="margin-top:14px">Email</span>
      <a href={`mailto:${site.email}`} class="foot-mail">{site.email}</a>
      <div class="foot-soc">
        <a href={site.linkedin} target="_blank" rel="noopener" aria-label="Redbarn Ventures on LinkedIn"><LinkedIn /></a>
        <a href={site.instagram} aria-label="Redbarn Ventures on Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/></svg></a>
        <a href={`mailto:${site.email}`} aria-label="Email Redbarn Ventures"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="2" y="3.5" width="12" height="9" rx="1.5"/><path d="M2.5 4.5 8 9l5.5-4.5"/></svg></a>
      </div>
      <a href="/contact" class="btn btn-p btn-sm" style="margin-top:14px;align-self:flex-start">Start a project</a>
    </div>
    <div><span class="label faint">Services</span>{services.map((s) => <a href={`/services/${s.slug}`}>{s.nav}</a>)}</div>
    <div><span class="label faint">Agency</span><a href="/about">About</a><a href="/ai">AI and automation</a><a href="/industries">Industries</a><a href="/process">Process</a><a href="/insights">Insights</a><a href="/services">All services</a><a href="/contact">Contact</a></div>
    <div><span class="label faint">Follow</span><a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a><a href={site.instagram}>Instagram</a><a href={`mailto:${site.email}`}>Email</a><span class="label faint" style="margin-top:18px">Legal</span><a href="/privacy">Privacy policy</a><a href="/terms">Terms of use</a><a href="/imprint">Imprint</a></div>
  </div>
  <div class="foot-word" aria-hidden="true">Redbarn<span>.</span></div>
  <div class="foot-bot"><span>©2026 Redbarn Ventures. Established 2023. All rights reserved.</span><nav class="foot-legal" aria-label="Legal"><a href="/privacy">Privacy</a><a href="/terms">Terms</a><a href="/imprint">Imprint</a><a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a><a href={site.instagram}>Instagram</a><a href="#top" data-top>Back to top ↑</a></nav></div>
</footer>
