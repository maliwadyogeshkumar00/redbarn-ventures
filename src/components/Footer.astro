---
import site from '../data/site.json'
import Logo from './Logo.astro'
---
<footer class="frame" style="border-top:1px solid var(--line)">
  <div class="foot-cols">
    <div><Logo /><p class="mute" style="margin-top:10px;max-width:30ch">{site.tagline} One small senior team, from first logo to the boardroom.</p><a href={`mailto:${site.email}`} style="margin-top:8px">{site.email}</a></div>
    <div><span class="label faint">Studio</span><a href="/work">Work</a><a href="/services">Services</a><a href="/about">About</a></div>
    <div><span class="label faint">Capital</span><a href="/investing">Investing</a><a href="/contact">Contact</a></div>
    <div><span class="label faint">Legal</span><a href="/imprint">Imprint</a><a href="/privacy">Privacy</a></div>
  </div>
  <div class="foot-word" aria-hidden="true">Redbarn<span>.</span></div>
  <div class="foot-bot"><span>©2026 Redbarn Ventures</span><a href="#top" data-top>Back to top ↑</a></div>
</footer>
