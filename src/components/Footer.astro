---
import site from '../data/site.json'
import services from '../data/services.json'
import Logo from './Logo.astro'
---
<footer class="frame" style="border-top:1px solid var(--line)">
  <div class="foot-cols">
    <div><Logo /><p class="mute" style="margin-top:10px;max-width:32ch">{site.tagline} One senior team for your brand, website and growth - before, during and long after launch.</p><a href={`mailto:${site.email}`} style="margin-top:8px">{site.email}</a><a href="/contact" class="btn btn-p btn-sm" style="margin-top:10px;align-self:flex-start">Start a project</a></div>
    <div><span class="label faint">Services</span>{services.map((s) => <a href={`/services/${s.slug}`}>{s.nav}</a>)}</div>
    <div><span class="label faint">Studio</span><a href="/services">All services</a><a href="/#process">Process</a><a href="/about">About</a><a href="/#faq">FAQ</a><a href="/contact">Contact</a></div>
    <div><span class="label faint">Legal</span><a href="/privacy">Privacy policy</a><a href="/terms">Terms of use</a><a href="/imprint">Imprint</a></div>
  </div>
  <div class="foot-word" aria-hidden="true">Redbarn<span>.</span></div>
  <div class="foot-bot"><span>©2026 Redbarn Ventures. All rights reserved.</span><nav class="foot-legal" aria-label="Legal"><a href="/privacy">Privacy</a><a href="/terms">Terms</a><a href="/imprint">Imprint</a><a href="#top" data-top>Back to top ↑</a></nav></div>
</footer>
