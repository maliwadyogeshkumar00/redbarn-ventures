---
import Art from './Art.astro'
import Arrow from './Arrow.astro'
interface Props { p: { slug: string; n: string; name: string; category: string; role: string; obj: string; cat?: string; tags?: string[] }; class?: string }
const { p, class: cls = '' } = Astro.props
---
<a href={`/work/${p.slug}`} class={`card ${cls}`} data-cat={p.cat}>
  <div class="tile mono">
    <span class="tile-ph">Image placeholder</span>
    <div class="tile-art"><Art kind={p.obj} /></div>
    <span class="tile-go" aria-hidden="true"><Arrow dir="ne" /></span>
  </div>
  <div class="card-body">
    <div class="card-top"><span class="card-name">{p.name}</span><span class="faint card-n">{p.n}</span></div>
    <p class="mute card-role">{p.role}</p>
    <div class="card-tags"><span class="tag">{p.category}</span></div>
  </div>
</a>
<style>
  .card{display:flex;flex-direction:column;border:1px solid var(--line);border-radius:12px;background:#fff;overflow:hidden;transition:transform .5s var(--ease),border-color .3s}
  .card:hover,.card:focus-visible{transform:translateY(-4px);border-color:var(--line-2)}
  .tile{position:relative;aspect-ratio:16/11;background:var(--hatch),#FCFCFC;border-bottom:1px solid var(--line);overflow:hidden}
  .tile-ph{position:absolute;left:12px;top:10px;font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--faint);background:#fff;padding:2px 6px;border-radius:4px;border:1px solid var(--line);z-index:1}
  .tile-art{position:absolute;inset:14% 20%;filter:grayscale(1);transition:filter .6s var(--ease),transform .8s var(--ease)}
  .tile-art :global(.art){width:100%;height:100%}
  .tile-go{position:absolute;right:10px;top:10px;width:30px;height:30px;border-radius:7px;background:var(--red);color:#fff;display:grid;place-items:center;opacity:0;transform:scale(.6);transition:opacity .35s var(--ease),transform .45s var(--ease)}
  .tile-go :global(svg){width:12px;height:12px}
  .card:hover .tile-art,.card:focus-visible .tile-art{filter:none;transform:scale(1.04)}
  .card:hover .tile-go,.card:focus-visible .tile-go{opacity:1;transform:none}
  .card:hover :global(.mono .art .rd){fill:var(--red)}
  .card-body{padding:14px 16px 16px;display:flex;flex-direction:column;gap:6px}
  .card-top{display:flex;justify-content:space-between;align-items:baseline;gap:12px}
  .card-name{font-size:16px;letter-spacing:-.015em}
  .card-n{font-size:12px;font-variant-numeric:tabular-nums}
  .card-role{font-size:13.5px;line-height:1.45}
  .card-tags{display:flex;gap:6px;margin-top:4px}
</style>
