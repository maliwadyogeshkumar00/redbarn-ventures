---
import Art from './Art.astro'
import Arrow from './Arrow.astro'
interface Props { p: { slug: string; n: string; name: string; category: string; role: string; obj: string; cat?: string }; class?: string; tall?: boolean; showRole?: boolean }
const { p, class: cls = '', tall = false, showRole = true } = Astro.props
---
<a href={`/work/${p.slug}`} class={`card ${cls}`} data-cat={p.cat}>
  <div class={`tile mono ${tall ? 'tall' : ''}`}>
    <span class="label tile-ph">Image placeholder</span>
    <div class="tile-art"><Art kind={p.obj} /></div>
    <span class="tile-go" aria-hidden="true"><Arrow dir="ne" /></span>
  </div>
  <div class="card-meta">
    <span class="label mute">{p.n}</span>
    <span class="card-name">{p.name}</span>
    <span class="label mute card-cat">{p.category}</span>
  </div>
  {showRole && <p class="mute card-role">{p.role}</p>}
</a>
<style>
  .card{display:block}
  .tile{position:relative;aspect-ratio:4/3;background:var(--clay);overflow:hidden;transition:transform .7s var(--ease),background .6s var(--ease)}
  .tile.tall{aspect-ratio:4/5}
  .tile-ph{position:absolute;left:16px;top:14px;color:#A6A6A6;z-index:1}
  .tile-art{position:absolute;inset:14% 12%;display:grid;place-items:center;filter:grayscale(1);transition:filter .7s var(--ease),transform .9s var(--ease)}
  .tile-art :global(.art){height:100%;width:auto;max-width:100%}
  .tile-go{position:absolute;right:14px;top:12px;width:34px;height:34px;border-radius:50%;background:var(--red);color:#fff;display:grid;place-items:center;opacity:0;transform:scale(.5) rotate(-45deg);transition:opacity .4s var(--ease),transform .55s var(--ease)}
  .tile-go :global(svg){width:13px;height:13px}
  .card:hover .tile,.card:focus-visible .tile{transform:translateY(-4px);background:var(--tint)}
  .card:hover .tile-art,.card:focus-visible .tile-art{filter:none;transform:scale(1.04)}
  .card:hover .tile-go,.card:focus-visible .tile-go{opacity:1;transform:none}
  .card:hover :global(.mono .art .rd){fill:var(--red)}
  .card-meta{display:grid;grid-template-columns:44px 1fr auto;gap:12px;padding-top:12px;align-items:baseline;border-top:1px solid var(--line);margin-top:12px}
  .card-name{font-size:17px;letter-spacing:-.015em}
  .card-role{padding:4px 0 0 56px;font-size:14px}
  @media (max-width:768px){.card-role{padding-left:0}}
</style>
