---
import Base from '../../layouts/Base.astro'
---
<Base title="LinkedIn logo" noindex bare>
  <div class="ll"><div class="ll-m"><i></i><i></i><i></i></div></div>
</Base>
<style is:global>
  html,body{background:#fff!important;overflow:hidden;margin:0}
  .ll{width:400px;height:400px;display:grid;place-items:center;background:#fff}
  .ll-m{display:flex;gap:16px}
  .ll-m i{width:46px;height:150px;background:#A3101C;transform:skewX(-16deg);border-radius:5px}
</style>
