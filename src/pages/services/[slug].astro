---
import Base from '../../layouts/Base.astro'
import PageHero from '../../components/PageHero.astro'
import CtaBand from '../../components/CtaBand.astro'
import Faq from '../../components/Faq.astro'
import Art from '../../components/Art.astro'
import Arrow from '../../components/Arrow.astro'
import services from '../../data/services.json'
import site from '../../data/site.json'

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { s } }))
}
const { s } = Astro.props
const related = s.related.map((r: string) => services.find((x) => x.slug === r)).filter(Boolean)
const mail = `mailto:${site.email}?subject=${encodeURIComponent(`Enquiry: ${s.title}`)}`
const lead = s.intro.split('. ')[0].replace(/\.$/, '') + '.'
const faq = s.faq.slice(0, 3)
const ld = [
  { '@context': 'https://schema.org', '@type': 'Service', name: s.title, description: s.meta, serviceType: s.title, url: `https://redbarn.ventures/services/${s.slug}/`, areaServed: 'Worldwide', provider: { '@type': 'Organization', '@id': 'https://redbarn.ventures/#org', name: 'Redbarn Ventures', url: 'https://redbarn.ventures/' }, hasOfferCatalog: { '@type': 'OfferCatalog', name: s.title, itemListElement: s.included.map((i) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: i.t, description: i.d } })) } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://redbarn.ventures/' }, { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://redbarn.ventures/services' }, { '@type': 'ListItem', position: 3, name: s.title }] },
]
---
<Base title={s.title} description={s.meta} jsonld={ld}>
  <PageHero label={`Service ${s.n} · ${s.nav}`} title={s.hero} lead={lead} crumbs={[{ t: 'Services', h: '/services' }, { t: s.title }]}>
    <div class="hero-btns rv" style="transition-delay:.35s">
      <a href="/contact" class="btn btn-p">Discuss your project <Arrow /></a>
      <a href={mail} class="btn btn-o">Email us</a>
    </div>
  </PageHero>

  <section class="frame row" aria-label="Why Redbarn">
    <ul class="proof3">
      {s.proof.map((p, i) => (
        <li class="rv" style={`transition-delay:${i * 80}ms`}>
          <span class="p3-ic" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></span>
          <span><b>{p.t}</b><small>{p.d}</small></span>
        </li>
      ))}
    </ul>
  </section>

  <section class="frame row" aria-labelledby="inc-h">
    <div class="sec-h in-pad">
      <div><span class="label faint">/What's included</span><h2 class="h2" id="inc-h" data-split data-bold="2">Everything you need, nothing you don't.</h2></div>
      <p class="lead rv">Scoped to your goals - the building blocks we combine most often.</p>
    </div>
    <div class="bento in-pad">
      <div class="bt-feat rv">
        <div class="bf-top"><span class="faint">services /</span>&nbsp;{s.slug}<span class="sc-n">{s.n}</span></div>
        <div class="bf-art hatch" aria-hidden="true"><Art kind={s.obj} /></div>
        <p class="bf-sum">{s.tag}.</p>
      </div>
      {s.included.map((it, i) => (
        <div class={`bt-item rv ${i === 5 ? 'wide' : ''}`} style={`transition-delay:${(i % 3) * 60}ms`}>
          <span class="bi-n">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="h3">{it.t}</h3>
          <p class="mute">{it.d}</p>
        </div>
      ))}
      <a href="/contact" class="bt-cta rv"><span class="label">Next step</span><span class="bc-big">Get a plan and quote</span><span class="bc-arr"><Arrow dir="ne" /></span></a>
    </div>
  </section>

  <section class="frame row" aria-labelledby="st-h">
    <div class="sec-h in-pad" style="grid-template-columns:1fr auto">
      <div><span class="label faint">/How it works</span><h2 class="h2" id="st-h" data-split data-bold="2">Four steps, no surprises.</h2></div>
      <a href="/services#ways" class="btn btn-o btn-sm">Projects or monthly partnership - see options <Arrow /></a>
    </div>
    <ol class="steps4">
      {s.steps.map((t, i) => (
        <li class="rv" style={`transition-delay:${i * 70}ms`}><span class="s4-n">{`0${i + 1}`}</span><b>{s.process[i].t}</b><small>{t}</small><span class="s4-bar" aria-hidden="true"></span></li>
      ))}
    </ol>
  </section>

  <Faq items={faq} title={`${s.title}: quick answers.`} more />

  <section class="frame row rel" aria-labelledby="rel-h">
    <div class="sec-h in-pad" style="grid-template-columns:1fr auto"><div><span class="label faint">/Related</span><h2 class="h2" id="rel-h" data-split data-bold="2">Often combined with.</h2></div><a href="/services" class="btn btn-o">All services <Arrow /></a></div>
    <div class="relx in-pad">
      {related.map((r) => (
        <a href={`/services/${r.slug}`} class="rx rv"><span class="rx-a hatch"><Art kind={r.obj} /></span><span><b>{r.title}</b><small>{r.tag}</small></span><Arrow /></a>
      ))}
    </div>
  </section>

  <CtaBand title={`Let's talk about your ${s.cta}.`} lead="Tell us what you need. A senior person replies with a plan and quote." />
</Base>
