---
import Base from '../../layouts/Base.astro'
import PageHero from '../../components/PageHero.astro'
import CtaBand from '../../components/CtaBand.astro'
import Faq from '../../components/Faq.astro'
import Art from '../../components/Art.astro'
import Arrow from '../../components/Arrow.astro'
import services from '../../data/services.json'
import H from '../../data/home.json'
const together = [
  { t: 'Start anywhere', d: 'Most clients begin with one urgent need - a new website, a rebrand, a sales deck. We solve that first, properly, without forcing a bigger package on you.' },
  { t: 'Connected by one brief', d: 'Because every service is planned from the same understanding of your business, your brand, website, content and campaigns reinforce each other instead of pulling in different directions.' },
  { t: 'Supported for the long term', d: 'After launch we stay available for updates, new pages, campaigns and fresh materials, so your brand keeps improving rather than slowly going out of date.' },
]
const ld = [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: H.faq.slice(0, 3).map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }]
---
<Base title="Services" description="Eleven services from one agency: branding, websites, AI agents, marketing, SEO, lead generation, influencer, video, trade shows and consulting." jsonld={ld}>
  <PageHero label="Services" title="Eleven services. One senior team." lead="Senior specialists, one brief, one point of contact." crumbs={[{ t: 'Services' }]}>
    <div class="hero-btns rv" style="transition-delay:.35s"><a href="/contact" class="btn btn-p">Start a project <Arrow /></a><a href="#ways" class="btn btn-o">Ways to work with us</a></div>
  </PageHero>

  <section class="frame row" aria-labelledby="all-h">
    <div class="sec-h in-pad">
      <div><span class="label faint">/All services</span><h2 class="h2" id="all-h" data-split data-bold="2">Choose what you need today.</h2></div>
      <p class="lead rv">Each stands alone. Together they compound.</p>
    </div>
    <div class="b-grid in-pad">
      {services.map((s, i) => (
        <a href={`/services/${s.slug}`} class="bcard rv" style={`transition-delay:${(i % 3) * 70}ms`}>
          <div class="bc-tile hatch"><span class="bc-n">{s.n}</span><div class="bc-art"><Art kind={s.obj} /></div></div>
          <div class="bc-body">
            <h3 class="h3">{s.title}</h3>
            <p class="mute">{s.tag}</p>
            <span class="bc-more">Explore <Arrow /></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="frame row" aria-labelledby="tog-h">
    <div class="st-row in-pad" style="padding-top:clamp(56px,7vw,96px)">
      <h2 class="st-title" id="tog-h" data-split data-bold="2">Four suppliers, four briefs. Or one agency.</h2>
      <div class="st-diag hatch rv" aria-hidden="true">
        <div class="sd-inner">
          <ul class="sd-left">{['Designer', 'Developer', 'Agency', 'Consultant'].map((t) => <li>{t}</li>)}</ul>
          <svg class="sd-lines" viewBox="0 0 120 200" preserveAspectRatio="none"><path d="M0 25 C60 25 60 100 120 100M0 75 C60 75 60 100 120 100M0 125 C60 125 60 100 120 100M0 175 C60 175 60 100 120 100" fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke"/></svg>
          <div class="sd-one"><span class="mark"><i></i><i></i><i></i></span>One Redbarn team</div>
        </div>
      </div>
    </div>
  </section>

  <section class="frame row engage" id="ways" aria-labelledby="e-h">
    <div class="sec-h in-pad">
      <div><span class="label faint">/Ways to work with us</span><h2 class="h2" id="e-h" data-split data-bold="2">Start small or build for the long run.</h2></div>
      <p class="lead rv">Every engagement starts with a written plan and quote.</p>
    </div>
    <div class="e-grid in-pad">
      {H.engage.map((e, i) => (
        <article class={`ecard rv ${e.featured ? 'feat' : ''}`} style={`transition-delay:${i * 80}ms`}>
          <div class="e-top"><h3 class="h3">{e.t}</h3><span class={`tag ${e.featured ? 'tag-r' : ''}`}>{e.tag}</span></div>
          <p class="mute">{e.d}</p>
          <ul>{e.points.map((p) => <li><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>{p}</li>)}</ul>
          <a href="/contact" class={`btn ${e.featured ? 'btn-p' : 'btn-o'}`}>Get a plan and quote <Arrow /></a>
        </article>
      ))}
    </div>
  </section>

  <Faq items={H.faq.slice(0, 3)} more />
  <CtaBand />
</Base>
