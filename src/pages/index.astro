---
import Base from '../layouts/Base.astro'
import Art from '../components/Art.astro'
import Icon from '../components/Icon.astro'
import Arrow from '../components/Arrow.astro'
import site from '../data/site.json'
import services from '../data/services.json'
import H from '../data/home.json'
const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hi Redbarn, I would like to discuss a project.')}`
const mail = `mailto:${site.email}?subject=${encodeURIComponent('Project enquiry')}`
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: H.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }
const svcLd = { '@context': 'https://schema.org', '@type': 'ProfessionalService', name: 'Redbarn Ventures', url: 'https://redbarn.ventures/', email: site.email, description: site.description, hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Services', itemListElement: services.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.title, description: s.short } })) } }
---
<Base description={site.description} jsonld={[faqLd, svcLd]}>
  <!-- HERO -->
  <section class="frame hero">
    <div class="hero-grid">
      <div class="hatch side" aria-hidden="true"></div>
      <div class="hero-c">
        <span class="chip rv"><i></i>{H.hero.chip}</span>
        <h1 class="display" data-split data-delay="100">{H.hero.title}</h1>
        <p class="lead rv" style="transition-delay:.25s">{H.hero.lead}</p>
        <div class="hero-btns rv" style="transition-delay:.35s">
          <a href="#contact" class="btn btn-p">Start a project <Arrow /></a>
          <a href="#services" class="btn btn-o">See our services</a>
        </div>
        <ul class="proof rv" style="transition-delay:.45s">{H.hero.proof.map((p) => <li><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>{p}</li>)}</ul>
      </div>
      <div class="hatch side" aria-hidden="true"></div>
    </div>
    <div class="strip" aria-hidden="true"><span></span><span class="hatch"></span><span></span><span class="hatch"></span><span></span><span class="hatch"></span><span></span></div>
  </section>

  <!-- STUDIO BOARD -->
  <section class="frame board-row" aria-label="What a typical month of studio work looks like">
    <div class="board rv">
      <div class="b-side" aria-hidden="true">
        <span class="b-mark"><span class="mark"><i></i><i></i><i></i></span></span>
        {['cube', 'lattice', 'slabs', 'arrow', 'monolith'].map((k, i) => <span class={`b-ico ${i === 0 ? 'on' : ''}`}><Icon kind={k} /></span>)}
      </div>
      <div class="b-main">
        <div class="b-top" aria-hidden="true"><div><span class="faint">studio /</span> board</div><span class="tag">This month</span></div>
        <div class="b-title"><span class="h3">Redbarn studio</span><span class="faint">A typical month of work across our practices</span></div>
        <div class="b-tabs" aria-hidden="true"><span class="on">Board</span><span>List</span><span>Timeline</span></div>
        <div class="b-cols">
          {H.board.map((col, ci) => (
            <div class="b-col">
              <div class="b-head"><i class={ci === 0 ? 'r' : ''}></i>{col.t} <span class="faint">({col.items.length})</span></div>
              {col.items.map((it) => (
                <div class="b-card">
                  {it.art && <div class="b-thumb hatch" aria-hidden="true"><Art kind={it.art} /></div>}
                  <div class="b-name">{it.n}</div>
                  <div class="b-role">{it.d}</div>
                  <div class="b-tags">{it.tags.map((t) => <span class="tag">{t}</span>)}</div>
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
    <div class="board-hatch hatch" aria-hidden="true"></div>
  </section>

  <!-- STATEMENT -->
  <section class="frame row top statement">
    <div class="st-row in-pad">
      <h2 class="st-title" data-split>{H.statement.title}</h2>
      <div class="st-diag hatch rv" aria-hidden="true">
        <div class="sd-inner">
          <ul class="sd-left">{['Designer', 'Developer', 'Agency', 'Consultant'].map((t) => <li>{t}</li>)}</ul>
          <svg class="sd-lines" viewBox="0 0 120 200" preserveAspectRatio="none"><path d="M0 25 C60 25 60 100 120 100M0 75 C60 75 60 100 120 100M0 125 C60 125 60 100 120 100M0 175 C60 175 60 100 120 100" fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke"/></svg>
          <div class="sd-one"><span class="mark"><i></i><i></i><i></i></span>One Redbarn team</div>
        </div>
      </div>
    </div>
    <ol class="st-points">
      {H.statement.points.map((p, i) => <li class="rv" style={`transition-delay:${i * 80}ms`}><span class="num">0{i + 1}</span><h3 class="h3">{p.t}</h3><p class="mute">{p.d}</p></li>)}
    </ol>
  </section>

  <!-- SERVICES -->
  <section class="frame row svc" id="services" aria-labelledby="svc-h">
    <div class="sec-h in-pad">
      <div><span class="label faint">/Services</span><h2 class="h2" id="svc-h" data-split>Everything your brand needs to grow.</h2></div>
      <p class="lead rv">Take one service or all five. Each is led by a senior specialist, and all of them work from the same brief - so your logo, website, deck and campaigns finally look and sound like one company.</p>
    </div>
    <div class="svc-body">
      <div class="svc-list" role="tablist" aria-label="Services">
        {services.map((s, i) => (
          <button class={`svc-item ${i === 0 ? 'on' : ''}`} role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`svc-p-${i}`} id={`svc-t-${i}`} tabindex={i === 0 ? 0 : -1}>
            <span class="svc-t"><Icon kind={s.obj} /><span class="h3">{s.title}</span><span class="faint svc-n">{s.n}</span></span>
            <span class="svc-d mute">{s.short}</span>
            <span class="svc-bar" aria-hidden="true"></span>
          </button>
        ))}
      </div>
      <div class="svc-stage">
        <div class="svc-frame hatch">
          {services.map((s, i) => (
            <div class={`svc-card ${i === 0 ? 'on' : ''}`} role="tabpanel" id={`svc-p-${i}`} aria-labelledby={`svc-t-${i}`} hidden={i !== 0}>
              <div class="sc-top"><span class="faint">services /</span>&nbsp;{s.slug}<span class="sc-n">{s.n}</span></div>
              <h3 class="sc-title">{s.title}</h3>
              <p class="sc-intro">{s.intro}</p>
              <div class="sc-art" aria-hidden="true"><Art kind={s.obj} /></div>
              <div class="sc-row"><span class="faint">Includes</span><div class="sc-tags">{s.included.map((t) => <span class="tag">{t}</span>)}</div></div>
              <div class="sc-row"><span class="faint">Process</span><ol class="sc-steps">{s.process.map((p, j) => <li><span class="faint">0{j + 1}</span> {p.t}</li>)}</ol></div>
              <a class="sc-link" href="#contact">Discuss {s.title.toLowerCase()} <Arrow /></a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT WE BUILD -->
  <section class="frame row build" id="build" aria-labelledby="b-h">
    <div class="sec-h in-pad">
      <div><span class="label faint">/What we build</span><h2 class="h2" id="b-h" data-split>The work, not the logos.</h2></div>
      <p class="lead rv">We keep client names private. What we can show you is the kind of work we make every week - and how each piece is set up to keep working for you long after it ships.</p>
    </div>
    <div class="b-grid in-pad">
      {H.build.map((b, i) => (
        <article class="bcard rv" style={`transition-delay:${(i % 3) * 70}ms`}>
          <div class="bc-tile hatch"><span class="bc-n">0{i + 1}</span><div class="bc-art"><Art kind={b.obj} /></div></div>
          <div class="bc-body">
            <h3 class="h3">{b.t}</h3>
            <p class="mute">{b.d}</p>
            <div class="bc-tags">{b.tags.map((t) => <span class="tag">{t}</span>)}</div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- TRUST -->
  <section class="frame row trust" aria-labelledby="t-h">
    <div class="sec-h in-pad">
      <div><span class="label faint">/Why teams stay</span><h2 class="h2" id="t-h" data-split>A partner you can hand your brand to.</h2></div>
      <p class="lead rv">Handing your brand to an outside team is a big decision. These are the promises we work by, on every project, for every client.</p>
    </div>
    <ul class="t-grid">
      {H.trust.map((t, i) => (
        <li class="rv" style={`transition-delay:${(i % 3) * 70}ms`}>
          <span class="t-ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></span>
          <h3 class="h3">{t.t}</h3>
          <p class="mute">{t.d}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- PROCESS -->
  <section class="frame row process" id="process" aria-labelledby="p-h">
    <div class="sec-h in-pad">
      <div><span class="label faint">/Process</span><h2 class="h2" id="p-h" data-split>From first call to long-term growth.</h2></div>
      <p class="lead rv">A simple, transparent way of working. You always know what happens next, who is doing it and when it will be ready.</p>
    </div>
    <ol class="p-grid">
      {H.process.map((p, i) => (
        <li class="rv" style={`transition-delay:${i * 80}ms`}>
          <div class="p-top"><span class="p-n">{`0${i + 1}`}</span><span class="p-line" aria-hidden="true"></span></div>
          <h3 class="h3">{p.t}</h3>
          <p class="mute">{p.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- ENGAGEMENTS -->
  <section class="frame row engage" aria-labelledby="e-h">
    <div class="sec-h in-pad">
      <div><span class="label faint">/Ways to work with us</span><h2 class="h2" id="e-h" data-split>Start small or build for the long run.</h2></div>
      <p class="lead rv">Every engagement starts with a written plan and quote. Choose the model that fits where your business is today - and change it as you grow.</p>
    </div>
    <div class="e-grid in-pad">
      {H.engage.map((e, i) => (
        <article class={`ecard rv ${e.featured ? 'feat' : ''}`} style={`transition-delay:${i * 80}ms`}>
          <div class="e-top"><h3 class="h3">{e.t}</h3><span class={`tag ${e.featured ? 'tag-r' : ''}`}>{e.tag}</span></div>
          <p class="mute">{e.d}</p>
          <ul>{e.points.map((p) => <li><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>{p}</li>)}</ul>
          <a href="#contact" class={`btn ${e.featured ? 'btn-p' : 'btn-o'}`}>Get a plan and quote <Arrow /></a>
        </article>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="frame row faq" id="faq" aria-labelledby="f-h">
    <div class="faq-grid">
      <div class="faq-l in-pad">
        <span class="label faint">/FAQ</span>
        <h2 class="h2" id="f-h" data-split>Questions we hear before every project.</h2>
        <p class="lead rv">Something else on your mind? Message us on WhatsApp or email - a senior person replies, not a bot.</p>
      </div>
      <div class="faq-r">
        {H.faq.map((f, i) => (
          <details class="qa" open={i === 0}>
            <summary><span>{f.q}</span><i aria-hidden="true"></i></summary>
            <p class="mute">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT CTA -->
  <section class="frame row cta" id="contact" aria-labelledby="c-h">
    <div class="hatch side" aria-hidden="true"></div>
    <div class="cta-c">
      <span class="chip"><i></i>Taking on new projects</span>
      <h2 class="display" id="c-h" data-split>Tell us about your brand.</h2>
      <p class="lead rv">A few lines about your business and what you need is enough. We will arrange a short call and come back with a written plan and quote.</p>
      <div class="hero-btns rv">
        <a href={mail} class="btn btn-p">Email {site.email} <Arrow /></a>
        <a href={wa} class="btn btn-o" target="_blank" rel="noopener">WhatsApp us</a>
      </div>
    </div>
    <div class="hatch side" aria-hidden="true"></div>
  </section>
</Base>

<script>
  const items = [...document.querySelectorAll<HTMLButtonElement>('.svc-item')]
  const cards = [...document.querySelectorAll<HTMLElement>('.svc-card')]
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
  let cur = 0, timer = 0, paused = false, seen = false
  const go = (i: number, focus = false) => {
    cur = (i + items.length) % items.length
    items.forEach((b, j) => { const on = j === cur; b.classList.toggle('on', on); b.setAttribute('aria-selected', String(on)); b.tabIndex = on ? 0 : -1 })
    cards.forEach((c, j) => {
      const on = j === cur
      c.hidden = !on; c.classList.toggle('on', on)
      const art = c.querySelector('.art')
      if (on && art) { art.classList.remove('in'); requestAnimationFrame(() => requestAnimationFrame(() => art.classList.add('in'))) }
    })
    if (focus) items[cur].focus()
    restart()
  }
  const restart = () => {
    clearTimeout(timer)
    const b = items[cur]
    items.forEach((x) => x.classList.remove('run'))
    if (reduce || paused || !seen) return
    void b.offsetWidth; b.classList.add('run')
    timer = window.setTimeout(() => go(cur + 1), 6000)
  }
  items.forEach((b, i) => b.addEventListener('click', () => go(i)))
  document.querySelector('.svc-list')?.addEventListener('keydown', (e) => {
    const k = (e as KeyboardEvent).key
    if (k === 'ArrowDown' || k === 'ArrowRight') { e.preventDefault(); go(cur + 1, true) }
    if (k === 'ArrowUp' || k === 'ArrowLeft') { e.preventDefault(); go(cur - 1, true) }
  })
  const sec = document.querySelector('.svc-body')
  sec?.addEventListener('mouseenter', () => { paused = true; restart() })
  sec?.addEventListener('mouseleave', () => { paused = false; restart() })
  if (sec && 'IntersectionObserver' in window) new IntersectionObserver(([e]) => { seen = e.isIntersecting; restart() }, { threshold: 0.35 }).observe(sec)

  // process line fills as it scrolls into view
  const steps = document.querySelectorAll('.p-grid li')
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('lit'); io.unobserve(e.target) } }), { threshold: 0.6 })
    steps.forEach((s) => io.observe(s))
  } else steps.forEach((s) => s.classList.add('lit'))

  // one FAQ open at a time
  const qas = [...document.querySelectorAll<HTMLDetailsElement>('.qa')]
  qas.forEach((d) => d.addEventListener('toggle', () => { if (d.open) qas.forEach((o) => { if (o !== d) o.open = false }) }))
</script>

<style>
  .hero-grid{display:grid;grid-template-columns:72px 1fr 72px}
  .side{border-right:1px solid var(--line)}
  .hero-grid .side:last-child,.cta .side:last-child{border-right:0;border-left:1px solid var(--line)}
  .hero-c{display:flex;flex-direction:column;align-items:center;text-align:center;gap:22px;padding:clamp(72px,10vw,120px) var(--pad) clamp(52px,7vw,84px)}
  .hero-c h1{max-width:16ch}
  .hero-c .lead{max-width:52ch}
  .hero-btns{display:flex;gap:10px;flex-wrap:wrap;justify-content:center}
  .proof{display:flex;gap:8px 22px;flex-wrap:wrap;justify-content:center;font-size:13px;color:var(--mute);margin-top:4px}
  .proof li{display:inline-flex;align-items:center;gap:6px}
  .proof svg,.ecard li svg,.t-ico svg{width:14px;height:14px;color:var(--red)}
  .strip{display:grid;grid-template-columns:1fr 1.4fr .6fr 1.4fr .6fr 1.4fr 1fr;height:30px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
  .strip span{border-right:1px solid var(--line)}.strip span:last-child{border-right:0}

  .board-row{padding:36px clamp(16px,5vw,64px) 0;position:relative}
  .board{position:relative;z-index:1;display:grid;grid-template-columns:52px 1fr;border:1px solid var(--line-2);border-radius:14px;background:#fff;overflow:hidden;height:min(600px,70vw);box-shadow:0 30px 60px -40px rgba(0,0,0,.18)}
  .b-side{border-right:1px solid var(--line);display:flex;flex-direction:column;align-items:center;gap:14px;padding:14px 0;background:#FCFCFC}
  .b-mark{width:30px;height:30px;border-radius:8px;background:var(--ink);display:grid;place-items:center;margin-bottom:6px}
  .b-mark .mark{display:flex;gap:1.6px}.b-mark .mark i{width:4px;height:11px;background:var(--red);transform:skewX(-16deg);border-radius:1px}
  .b-ico{width:32px;height:32px;border-radius:8px;display:grid;place-items:center;color:#777}
  .b-ico.on{background:#F1F1F1;color:var(--ink)}
  .b-main{padding:14px 20px 0;min-width:0;display:flex;flex-direction:column}
  .b-top{display:flex;justify-content:space-between;align-items:center;font-size:12.5px}
  .b-title{display:flex;flex-direction:column;gap:2px;padding:16px 0 12px}
  .b-title .faint{font-size:12px}
  .b-tabs{display:flex;gap:4px;padding:4px;border:1px solid var(--line);border-radius:8px;width:max-content;font-size:12.5px;color:var(--mute);margin-bottom:16px}
  .b-tabs span{padding:4px 10px;border-radius:5px}.b-tabs .on{background:#F1F1F1;color:var(--ink)}
  .b-cols{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;flex:1;min-height:0;overflow:hidden}
  .b-col{display:flex;flex-direction:column;gap:10px;min-width:0}
  .b-head{font-size:12.5px;display:flex;align-items:center;gap:6px;padding-bottom:2px}
  .b-head i{width:7px;height:7px;border-radius:50%;background:#BDBDBD}.b-head i.r{background:var(--red)}
  .b-card{border:1px solid var(--line);border-radius:10px;padding:10px;display:flex;flex-direction:column;gap:6px;background:#fff;transition:border-color .3s,transform .4s var(--ease)}
  .b-card:hover{border-color:var(--red);transform:translateY(-2px)}
  .b-thumb{border-radius:6px;border:1px solid var(--line);aspect-ratio:16/9;position:relative;overflow:hidden}
  .b-thumb :global(.art){position:absolute;inset:10% 0;width:100%;height:80%}
  .b-name{font-size:13.5px;letter-spacing:-.01em}
  .b-role{font-size:12px;color:var(--mute);line-height:1.4}
  .b-tags{display:flex;gap:4px;flex-wrap:wrap}
  .board-hatch{position:absolute;left:50%;transform:translateX(-50%);bottom:-44px;width:60%;height:120px;border:1px solid var(--line);z-index:0}

  .statement{margin-top:44px;padding-top:clamp(72px,9vw,120px)}
  .st-row{display:grid;grid-template-columns:1.15fr 1fr;gap:40px;align-items:center;padding-bottom:clamp(40px,5vw,64px)}
  .st-title{font-size:clamp(26px,3vw,40px);line-height:1.15;letter-spacing:-.03em;max-width:28ch}
  .st-diag{border:1px solid var(--line);padding:22px}
  .sd-inner{background:#fff;border:1px solid var(--line-2);border-radius:12px;padding:18px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:0}
  .sd-left{display:flex;flex-direction:column;gap:10px}
  .sd-left li{font-size:13px;padding:6px 10px;border:1px solid var(--line);border-radius:6px;color:var(--mute);background:#FCFCFC}
  .sd-lines{width:100%;height:160px;color:var(--line-2)}
  .sd-one{display:flex;align-items:center;gap:8px;font-size:13.5px;padding:10px 12px;border:1px solid var(--red);border-radius:8px;color:var(--ink);box-shadow:0 0 0 3px rgba(215,38,61,.08);white-space:nowrap}
  .sd-one .mark{display:flex;gap:1.6px}.sd-one .mark i{width:4px;height:11px;background:var(--red);transform:skewX(-16deg);border-radius:1px}
  .st-points{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line)}
  .st-points li{padding:28px var(--pad) 36px;border-right:1px solid var(--line);display:flex;flex-direction:column;gap:10px}
  .st-points li:last-child{border-right:0}
  .num{font-size:12px;color:var(--red)}

  .sec-h{padding-top:clamp(64px,8vw,104px);padding-bottom:40px;display:grid;grid-template-columns:1.1fr 1fr;gap:32px;align-items:end}
  .sec-h h2{margin-top:10px}
  .sec-h .lead{max-width:50ch}

  .svc-body{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line)}
  .svc-list{display:flex;flex-direction:column;border-right:1px solid var(--line)}
  .svc-item{all:unset;box-sizing:border-box;cursor:pointer;position:relative;display:flex;flex-direction:column;gap:8px;padding:24px var(--pad);border-bottom:1px solid var(--line);color:var(--faint);transition:color .3s,background .3s}
  .svc-item:last-child{border-bottom:0}
  .svc-item:hover{background:#FCFCFC;color:var(--red)}
  .svc-item:focus-visible{outline:2px solid var(--red);outline-offset:-2px}
  .svc-item.on{color:var(--ink)}
  .svc-item.on :global(.ico){color:var(--red)}
  .svc-t{display:flex;align-items:center;gap:10px}
  .svc-n{margin-left:auto;font-size:12px}
  .svc-d{font-size:14px;max-height:0;overflow:hidden;opacity:0;transition:max-height .5s var(--ease),opacity .4s}
  .svc-item.on .svc-d{max-height:60px;opacity:1}
  .svc-bar{position:absolute;left:0;bottom:-1px;height:2px;width:100%;background:var(--red);transform:scaleX(0);transform-origin:0 50%}
  .svc-item.on .svc-bar{transform:scaleX(1)}
  .svc-item.run .svc-bar{transform:scaleX(0);animation:bar 6s linear forwards}
  @keyframes bar{to{transform:scaleX(1)}}
  .svc-stage{padding:32px clamp(16px,4vw,48px);display:grid;place-items:center}
  .svc-frame{width:100%;max-width:480px;padding:22px;border:1px solid var(--line)}
