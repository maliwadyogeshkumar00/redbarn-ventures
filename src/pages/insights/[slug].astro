---
import Base from '../../layouts/Base.astro'
import CtaBand from '../../components/CtaBand.astro'
import Art from '../../components/Art.astro'
import Arrow from '../../components/Arrow.astro'
import { getPosts } from '../../posts'
export function getStaticPaths() {
  const posts = getPosts()
  return posts.map((p) => ({ params: { slug: p.slug }, props: { p, others: posts.filter((o) => o.slug !== p.slug) } }))
}
const { p, others } = Astro.props
const Content = p.Content
const fmt = (d: string) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
const toc = p.headings.filter((h) => h.depth === 2)
const ld = [{ '@context': 'https://schema.org', '@type': 'Article', headline: p.title, description: p.description, datePublished: p.date, dateModified: p.date, author: { '@type': 'Organization', name: 'Redbarn Ventures', url: 'https://redbarn.ventures/' }, publisher: { '@type': 'Organization', name: 'Redbarn Ventures', logo: { '@type': 'ImageObject', url: 'https://redbarn.ventures/icon-512.png' } }, mainEntityOfPage: `https://redbarn.ventures/insights/${p.slug}` }]
---
<Base title={p.title} description={p.description} type="article" jsonld={ld}>
  <section class="frame hero">
    <div class="hero-grid">
      <div class="hatch side" aria-hidden="true"></div>
      <div class="hero-c ph art-hero">
        <nav class="crumbs rv" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/insights">Insights</a><span aria-hidden="true">/</span><span aria-current="page">{p.category}</span></nav>
        <span class="chip rv"><i></i>{p.category}</span>
        <h1 class="display post-h" data-split data-bold="2" data-delay="100">{p.title}</h1>
        <p class="lead rv">{p.excerpt}</p>
        <div class="il-meta rv"><span>By Redbarn Ventures</span><span>{fmt(p.date)}</span><span>{`${p.minutes} min read`}</span></div>
      </div>
      <div class="hatch side" aria-hidden="true"></div>
    </div>
  </section>
  <section class="frame row post">
    <aside class="post-side">
      <div class="ps-art hatch"><Art kind={p.art} /></div>
      <nav class="toc" aria-label="Contents"><span class="label faint">Contents</span>{toc.map((h) => <a href={`#${h.slug}`} data-no-wipe>{h.text}</a>)}</nav>
      <div class="ps-cta"><b>Need help with this?</b><p class="mute">Talk to a senior consultant about your situation.</p><a href="/contact" class="btn btn-p btn-sm">Start a conversation <Arrow /></a></div>
    </aside>
    <article class="post-body"><Content /></article>
  </section>
  <section class="frame row" aria-labelledby="more-h">
    <div class="sec-h in-pad" style="grid-template-columns:1fr auto"><div><span class="label faint">/Keep reading</span><h2 class="h2" id="more-h">More insights.</h2></div><a href="/insights" class="btn btn-o">All insights <Arrow /></a></div>
    <div class="more in-pad">
      {others.map((o) => <a href={`/insights/${o.slug}`} class="more-c"><span class="more-a hatch"><Art kind={o.art} /></span><span><span class="label faint">{o.category}</span><b>{o.title}</b></span><Arrow /></a>)}
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .post-h{font-size:clamp(36px,4.6vw,64px);max-width:20ch}
  .il-meta{display:flex;gap:16px;font-size:12.5px;color:var(--faint);flex-wrap:wrap;justify-content:center}
  .post{display:grid;grid-template-columns:300px 1fr}
  .post-side{border-right:1px solid var(--line);padding:32px var(--pad);display:flex;flex-direction:column;gap:20px;position:relative}
  .post-side>*{position:sticky;top:90px}
  .ps-art{height:160px;border:1px solid var(--line);border-radius:12px;position:relative}
  .ps-art :global(.art){position:absolute;inset:14% 24%;width:52%;height:72%}
  .toc{display:flex;flex-direction:column;gap:2px;font-size:13.5px;position:static!important}
  .toc a{padding:7px 0 7px 10px;border-left:1px solid var(--line);color:var(--mute);transition:color .2s,border-color .2s}
  .toc a:hover{color:var(--red);border-color:var(--red)}
  .ps-cta{border:1px solid var(--line-2);border-radius:12px;padding:16px;display:flex;flex-direction:column;gap:8px;background:var(--hatch),#fff;position:static!important}
  .ps-cta b{font-weight:400;font-size:16px;background:#fff;align-self:flex-start;padding:0 4px}
  .ps-cta p{font-size:13.5px;background:#fff;padding:0 4px}
  .ps-cta .btn{align-self:flex-start}
  .post-body{padding:48px clamp(20px,6vw,96px) 72px;max-width:860px}
  .post-body :global(h2){font-size:clamp(26px,2.6vw,34px);letter-spacing:-.035em;line-height:1.12;margin:56px 0 16px;scroll-margin-top:90px}
  .post-body :global(h2:first-child){margin-top:0}
  .post-body :global(h3){font-size:20px;letter-spacing:-.02em;margin:32px 0 10px}
  .post-body :global(p),.post-body :global(li){font-size:17px;line-height:1.7;color:#333}
  .post-body :global(p){margin:0 0 18px}
  .post-body :global(ul),.post-body :global(ol){margin:0 0 22px;padding-left:22px}
  .post-body :global(ul){list-style:none;padding-left:0}
  .post-body :global(ul li){position:relative;padding-left:22px;margin:8px 0}
  .post-body :global(ul li)::before{content:"";position:absolute;left:4px;top:.72em;width:6px;height:6px;border-radius:50%;background:var(--red)}
  .post-body :global(ol){list-style:decimal}
  .post-body :global(ol li){margin:10px 0;padding-left:6px}
  .post-body :global(ol li::marker){color:var(--red)}
  .post-body :global(strong){font-weight:600;color:var(--ink)}
  .post-body :global(blockquote){margin:36px 0;padding:26px 28px;border:1px solid var(--line-2);border-left:3px solid var(--red);border-radius:0 12px 12px 0;background:var(--hatch),#fff}
  .post-body :global(blockquote p){font-size:clamp(20px,2vw,26px);line-height:1.3;letter-spacing:-.025em;color:var(--ink);margin:0;background:#fff;display:inline}
  .post-body :global(hr){border:0;border-top:1px solid var(--line);margin:48px 0 28px}
  .post-body :global(em){color:var(--mute)}
  .post-body :global(a){color:var(--red);text-decoration:underline;text-underline-offset:3px}
  .more{display:grid;grid-template-columns:1fr 1fr;gap:16px;padding-bottom:var(--pad)}
  .more-c{display:grid;grid-template-columns:120px 1fr 20px;gap:18px;align-items:center;border:1px solid var(--line);border-radius:12px;padding:12px;transition:border-color .3s}
  .more-c:hover{border-color:var(--red)}.more-c:hover b{color:var(--red)}
  .more-a{height:90px;border-radius:8px;border:1px solid var(--line);position:relative}
  .more-a :global(.art){position:absolute;inset:10% 20%;width:60%;height:80%}
  .more-c b{display:block;font-weight:400;font-size:17px;letter-spacing:-.015em;margin-top:4px}
  .more-c :global(svg){width:14px;height:14px}
  @media (max-width:1024px){.post{grid-template-columns:1fr}.post-side{border-right:0;border-bottom:1px solid var(--line)}.post-side>*{position:static}.ps-art{display:none}.more{grid-template-columns:1fr}}
</style>
