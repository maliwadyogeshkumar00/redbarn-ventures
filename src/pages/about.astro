---
import Base from '../layouts/Base.astro'
import PageHero from '../components/PageHero.astro'
import CtaBand from '../components/CtaBand.astro'
import Art from '../components/Art.astro'
import Arrow from '../components/Arrow.astro'
import services from '../data/services.json'
import H from '../data/home.json'
const chapters = [
  { k: 'The problem', t: 'Too many suppliers.', d: 'A designer for the logo, a developer for the site, an agency for ads, a consultant for strategy - each good at their part, none owning the whole picture.' },
  { k: 'The idea', t: 'One senior agency.', d: 'Since 2023 the same team advises, designs, builds websites and AI, runs campaigns and prepares your materials - from one brief.' },
  { k: 'Senior by design', t: 'Real attention.', d: 'The people you meet in the first call are the people who do the work. Decisions are quick and no client is handed to juniors.' },
  { k: 'For the long run', t: 'We stay after launch.', d: 'Brands and websites are never finished. Long-term partnerships keep your company improving month after month.' },
]
const who = [
  { t: 'Established companies', d: 'Businesses with a strong product and a reputation to protect, whose brand, website or materials no longer reflect how good they are.' },
  { t: 'New ventures', d: 'Founders launching a product or company who want to look established from day one and build marketing that grows with them.' },
  { t: 'Technical and industrial firms', d: 'Companies selling complex products - energy, engineering, software - who need clear, credible communication for demanding buyers.' },
]
---
<Base title="About" description="Redbarn Ventures is a global brand, digital and growth agency, established in 2023. Our mission, vision, principles and the senior team approach behind our work.">
  <PageHero label="About Redbarn · Established 2023" title="A global agency for brands that want to grow." lead="We think like consultants and deliver like an agency. Since 2023, Redbarn Ventures has helped ambitious companies around the world look credible, sell more and work smarter - with one senior team that stays long after launch." crumbs={[{ t: 'About' }]} />

  <section class="frame row" aria-label="Facts">
    <ul class="facts">
      <li class="rv"><b>2023</b><span>Established</span></li>
      <li class="rv"><b>Global</b><span>Clients across continents and time zones</span></li>
      <li class="rv"><b>11</b><span>Services under one roof</span></li>
      <li class="rv"><b>1</b><span>Senior point of contact per client</span></li>
    </ul>
  </section>

  <section class="frame row" aria-labelledby="mv-h">
    <h2 class="sr" id="mv-h">Mission and vision</h2>
    <div class="mv">
      <div class="mv-c rv"><span class="label">/Our mission</span><p class="mv-t">To give every ambitious company the brand, technology and growth engine of a market leader - delivered by one senior team that treats their business as its own.</p></div>
      <div class="mv-c dark rv"><span class="label">/Our vision</span><p class="mv-t">A world where great products are never held back by weak marketing, slow websites or disconnected suppliers - and where AI frees people to do their best work.</p></div>
    </div>
    <div class="vals">
      {['Clarity', 'Ownership', 'Craft', 'Honesty', 'Long-term thinking'].map((v, i) => <span class="rv"><i>{`0${i + 1}`}</i>{v}</span>)}
    </div>
  </section>

  <section class="frame row" aria-labelledby="story-h">
    <h2 class="pull" id="story-h" data-split data-bold="2">Great products deserve brands, websites and marketing that work as one.</h2>
    <ol class="chapters">
      {chapters.map((c, i) => (
        <li class="chap rv" style={`transition-delay:${i * 80}ms`}><span class="k">{`0${i + 1} · ${c.k}`}</span><h3>{c.t}</h3><p>{c.d}</p></li>
      ))}
    </ol>
    <div class="about-band">
      <div class="ab-art hatch" aria-hidden="true"><div class="ab-box"><Art kind="sphere" /></div></div>
      <div class="ab-copy in-pad">
        <span class="label faint">/In one line</span>
        <p class="ab-line">Consulting, design, technology, AI and marketing - <span class="red">one global agency</span>, held together by one brief.</p>
        <a href="/services" class="btn btn-o" style="align-self:flex-start">See what we do <Arrow /></a>
      </div>
    </div>
  </section>

  <section class="frame row trust" aria-labelledby="pr-h">
    <div class="sec-h in-pad">
      <div><span class="label faint">/Principles</span><h2 class="h2" id="pr-h" data-split data-bold="2">How we treat every client.</h2></div>
      <p class="lead rv">These are not slogans. They are the rules we work by on every project, whatever its size.</p>
    </div>
    <ul class="t-grid">
      {H.trust.map((t, i) => (
        <li class="rv" style={`transition-delay:${(i % 3) * 70}ms`}><span class="t-ico" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></span><h3 class="h3">{t.t}</h3><p class="mute">{t.d}</p></li>
      ))}
    </ul>
  </section>

  <section class="frame row" aria-labelledby="who-h">
    <div class="sec-h in-pad">
      <div><span class="label faint">/Who we work with</span><h2 class="h2" id="who-h" data-split data-bold="2">Companies that care about quality.</h2></div>
      <p class="lead rv">We are a good fit for teams who want a long-term partner rather than the cheapest quote - and who value honest advice as much as beautiful work.</p>
    </div>
    <ol class="st-points">
      {who.map((p, i) => <li class="rv" style={`transition-delay:${i * 80}ms`}><span class="num">0{i + 1}</span><h3 class="h3">{p.t}</h3><p class="mute">{p.d}</p></li>)}
    </ol>
  </section>

  <section class="frame row" aria-labelledby="cap-h">
    <div class="sec-h in-pad" style="grid-template-columns:1fr auto"><div><span class="label faint">/Capabilities</span><h2 class="h2" id="cap-h" data-split data-bold="2">What we do every week.</h2></div><a href="/services" class="btn btn-o">All services <Arrow /></a></div>
    <ul class="cap-list">
      {services.map((s) => (
        <li class="rv"><a href={`/services/${s.slug}`}><span class="cap-n">{s.n}</span><span class="cap-t">{s.title}</span><span class="cap-tags">{s.included.slice(0, 4).map((t) => <span class="tag">{t.t}</span>)}</span><span class="cap-go"><Arrow /></span></a></li>
      ))}
    </ul>
  </section>

  <CtaBand title="Let's see if we are a fit." />
</Base>
<style>
  .about-copy{display:flex;flex-direction:column;gap:14px;margin-top:8px}
  .about-copy p{font-size:16px;line-height:1.65;color:#444;max-width:60ch}
  .cap-list{border-top:1px solid var(--line)}
  .cap-list a{display:grid;grid-template-columns:60px 1.1fr 2fr 30px;gap:16px;align-items:center;padding:20px var(--pad);border-bottom:1px solid var(--line);transition:background .25s}
  .cap-list li:last-child a{border-bottom:0}
  .cap-list a:hover{background:#FCFCFC}
  .cap-list a:hover .cap-t,.cap-list a:hover .cap-go{color:var(--red)}
  .cap-n{font-size:12px;color:var(--faint)}
  .cap-t{font-size:20px;letter-spacing:-.02em;transition:color .2s}
  .cap-tags{display:flex;gap:6px;flex-wrap:wrap}
  .cap-go :global(svg){width:14px;height:14px}
  @media (max-width:768px){.cap-list a{grid-template-columns:40px 1fr 24px}.cap-tags{grid-column:2/3}}
  .about-band{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line)}
  .ab-art{display:grid;place-items:center;padding:40px;border-right:1px solid var(--line)}
  .ab-box{width:min(300px,80%);background:#fff;border:1px solid var(--line-2);border-radius:14px;padding:28px}
  .ab-copy{display:flex;flex-direction:column;justify-content:center;gap:18px;padding-top:48px;padding-bottom:48px}
  .ab-line{font-size:clamp(22px,2.4vw,32px);letter-spacing:-.03em;line-height:1.2;max-width:22ch}
  .red{color:var(--red)}
  @media (max-width:900px){.about-band{grid-template-columns:1fr}.ab-art{border-right:0;border-bottom:1px solid var(--line)}}
.facts{display:grid;grid-template-columns:repeat(4,1fr)}
  .facts li{padding:28px var(--pad);border-right:1px solid var(--line);display:flex;flex-direction:column;gap:6px}
  .facts li:last-child{border-right:0}
  .facts b{font-weight:400;font-size:clamp(36px,4vw,56px);letter-spacing:-.045em;line-height:1}
  .facts li:first-child b{color:var(--red)}
  .facts span{font-size:13.5px;color:var(--mute)}
  .mv{display:grid;grid-template-columns:1fr 1fr;gap:16px;padding:var(--pad)}
  .mv-c{border:1px solid var(--line-2);border-radius:14px;padding:clamp(24px,3vw,40px);display:flex;flex-direction:column;gap:22px;min-height:300px;justify-content:space-between;background:var(--hatch),#fff}
  .mv-c .label{color:var(--red)}
  .mv-c.dark{background:var(--ink);color:#fff;border-color:var(--ink)}
  .mv-c.dark .label{color:#E39AA8}
  .mv-t{font-size:clamp(22px,2.4vw,32px);line-height:1.2;letter-spacing:-.03em;background:inherit}
  .mv-c:not(.dark) .mv-t{background:#fff;padding:14px 16px;border-radius:10px;border:1px solid var(--line)}
  .vals{display:flex;flex-wrap:wrap;border-top:1px solid var(--line)}
  .vals span{flex:1;min-width:160px;padding:18px var(--pad);border-right:1px solid var(--line);font-size:18px;letter-spacing:-.02em;display:flex;gap:10px;align-items:baseline}
  .vals span:last-child{border-right:0}
  .vals i{font-style:normal;font-size:11px;color:var(--red)}
  @media (max-width:900px){.facts{grid-template-columns:1fr 1fr}.facts li:nth-child(2){border-right:0}.facts li:nth-child(-n+2){border-bottom:1px solid var(--line)}.mv{grid-template-columns:1fr}.vals span{border-right:0;border-bottom:1px solid var(--line);min-width:100%}}
</style>
